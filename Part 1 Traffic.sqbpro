<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/Users/janic/traffic.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1270"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Metro_Traffic" custom_title="0" dock_id="1" table="4,13:mainMetro_Traffic"/><dock_state state="000000ff00000000fd00000001000000020000033b00000276fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000033b0000013300ffffff000002580000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Metro_Traffic" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="101"/><column index="2" value="54"/><column index="3" value="51"/><column index="4" value="59"/><column index="5" value="64"/><column index="6" value="101"/><column index="7" value="257"/><column index="8" value="156"/><column index="9" value="89"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT COUNT(*) FROM metro_traffic;
SELECT
    STRFTIME('%Y', date_time) AS year,
    SUM(traffic_volume) AS total_traffic
FROM metro_traffic
GROUP BY year
ORDER BY year;
WITH yearly AS (
    SELECT
        STRFTIME('%Y', date_time) AS year,
        SUM(traffic_volume) AS total_traffic
    FROM metro_traffic
    GROUP BY year
)
SELECT
    y1.year,
    y1.total_traffic,
    (y1.total_traffic - y0.total_traffic) AS change_vs_prev
FROM yearly y1
LEFT JOIN yearly y0
    ON CAST(y1.year AS INTEGER) = CAST(y0.year AS INTEGER) + 1
ORDER BY y1.year;
SELECT
    STRFTIME('%Y', date_time) AS year,
    AVG(temp) AS avg_temp,
    MIN(temp) AS min_temp,
    MAX(temp) AS max_temp
FROM metro_traffic
WHERE STRFTIME('%m-%d', date_time) = '01-01'
  AND STRFTIME('%Y', date_time) IN ('2015','2016','2017')
GROUP BY year
ORDER BY year;
SELECT
    STRFTIME('%Y', date_time) AS year,
    AVG(temp) AS avg_temp,
    MIN(temp) AS min_temp,
    MAX(temp) AS max_temp
FROM metro_traffic
WHERE holiday = 'Labor Day'
  AND STRFTIME('%Y', date_time) IN ('2015','2016','2017')
GROUP BY year
ORDER BY year;

SELECT AVG(traffic_volume) AS mean_traffic
FROM metro_traffic;

SELECT AVG(traffic_volume) AS median_traffic
FROM (
    SELECT traffic_volume
    FROM metro_traffic
    ORDER BY traffic_volume
    LIMIT 2 - (SELECT COUNT(*) FROM metro_traffic) % 2
    OFFSET (SELECT (COUNT(*) - 1) / 2 FROM metro_traffic)
);

SELECT 
    SQRT(AVG((traffic_volume - (SELECT AVG(traffic_volume) FROM metro_traffic)) * 
             (traffic_volume - (SELECT AVG(traffic_volume) FROM metro_traffic)))) 
    AS std_dev_traffic
FROM metro_traffic;

SELECT 
    AVG((traffic_volume - (SELECT AVG(traffic_volume) FROM metro_traffic)) * 
        (traffic_volume - (SELECT AVG(traffic_volume) FROM metro_traffic))) 
    AS variance_traffic
FROM metro_traffic;

SELECT 
    MAX(traffic_volume) - MIN(traffic_volume) AS range_traffic,
    MIN(traffic_volume) AS min_traffic,
    MAX(traffic_volume) AS max_traffic
FROM metro_traffic;

SELECT
    (
        (AVG(temp * traffic_volume) - AVG(temp) * AVG(traffic_volume))
        /
        (SQRT(AVG(temp * temp) - AVG(temp) * AVG(temp))
         * 
         SQRT(AVG(traffic_volume * traffic_volume) - AVG(traffic_volume) * AVG(traffic_volume)))
    ) AS correlation_temp_traffic
FROM metro_traffic;

SELECT 
    CAST(SUM(CASE WHEN traffic_volume &gt; 5500 THEN 1 ELSE 0 END) AS FLOAT)
    / COUNT(*) AS P_congestion
FROM metro_traffic;

SELECT 
    CAST(SUM(CASE WHEN weather_description LIKE '%Clear%' THEN 1 ELSE 0 END) AS FLOAT)
    / COUNT(*) AS P_clear_weather
FROM metro_traffic;

SELECT 
    CAST(SUM(
        CASE 
            WHEN traffic_volume &gt; 5500 
                 AND weather_description LIKE '%Clear%' 
            THEN 1 ELSE 0 
        END
    ) AS FLOAT)
    / COUNT(*) AS P_congestion_and_clear
FROM metro_traffic;

SELECT 
    CAST(SUM(CASE WHEN traffic_volume &gt; 5500 AND weather_description LIKE '%Clear%' THEN 1 ELSE 0 END) AS FLOAT)
    /
    SUM(CASE WHEN traffic_volume &gt; 5500 THEN 1 ELSE 0 END)
    AS P_clear_given_congestion
FROM metro_traffic;

SELECT 
    CAST(SUM(CASE WHEN traffic_volume &gt; 5500 AND temp &gt; 292 THEN 1 ELSE 0 END) AS FLOAT)
    /
    SUM(CASE WHEN traffic_volume &gt; 5500 THEN 1 ELSE 0 END)
    AS P_high_temp_given_congestion
FROM metro_traffic;

-- P(Congestion | Clear)
SELECT 
    CAST(SUM(CASE WHEN weather_description LIKE '%Clear%' 
                     AND traffic_volume &gt; 5500 THEN 1 ELSE 0 END) AS FLOAT)
    /
    SUM(CASE WHEN weather_description LIKE '%Clear%' THEN 1 ELSE 0 END)
    AS P_congestion_clear
FROM metro_traffic;

-- P(Congestion | Cloudy)
SELECT 
    CAST(SUM(CASE WHEN (weather_description LIKE '%Cloud%' 
                        OR weather_description LIKE '%Overcast%')
                     AND traffic_volume &gt; 5500 THEN 1 ELSE 0 END) AS FLOAT)
    /
    SUM(CASE WHEN (weather_description LIKE '%Cloud%' 
                   OR weather_description LIKE '%Overcast%') THEN 1 ELSE 0 END)
    AS P_congestion_cloudy
FROM metro_traffic;</sql><current_tab id="0"/></tab_sql></sqlb_project>
